rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /appData/{documentId} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          "zahi.ob4@gmail.com",
          "zoharavron@gmail.com"
        ];
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
